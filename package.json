{
  "name": "patcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "library:import": "node scripts/import-atlas.mjs",
    "library:verify": "node scripts/verify-library.mjs",
    "sew:check": "node scripts/sew-check.mjs",
    "library:audit": "node scripts/audit-library.mjs",
    "test:library": "node --test src/library-cache.test.js src/template-families.test.js"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "description": "SVG patch art to embroidered patches: digitizer, renderer, DST/EXP export, and a patch library grouped by organization.",
  "exports": {
    ".": "./src/index.ts",
    "./library": "./src/library.ts",
    "./library/join": "./src/library-join.js",
    "./library/manifest.json": "./library/manifest.json",
    "./library/*": "./library/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "library",
    "scripts"
  ]
}
