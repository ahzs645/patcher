{
  "$comment": "How scripts/import-atlas.mjs files each atlas design under an organization. Orgs are tried in order and the first whose rules match wins: 'family' and 'label' are regular expressions (case-insensitive) tested against the atlas design's family and label, 'affiliation' is the atlas's own coarse affiliation, matched exactly. Put specific rules before broad ones. A design nothing matches is filed under 'unsorted' and the import says so.",
  "sectors": [
    { "id": "government", "name": "Province of British Columbia" },
    { "id": "forests", "name": "Forests and wildfire" },
    { "id": "environment", "name": "Parks, environment and wildlife" },
    { "id": "justice", "name": "Justice and public safety" },
    { "id": "transportation", "name": "Transportation" },
    { "id": "crown", "name": "Crown corporations" },
    { "id": "lands", "name": "Land and survey" },
    { "id": "institutions", "name": "Universities and institutions" },
    { "id": "community", "name": "Events and societies" },
    { "id": "unconfirmed", "name": "Unconfirmed" }
  ],
  "orgs": [
    {
      "id": "province-of-bc",
      "name": "Province of British Columbia",
      "sector": "government",
      "description": "The Province's own identity: ministry lockups, the provincial arms, and programme marks.",
      "match": { "family": ["^bc-government-logo$", "^provincial-arms$", "^bc-public-service$", "^cleanbc$", "^strongerbc$", "^top-work-award$", "^centennial$"] }
    },
    {
      "id": "bc-timber-sales",
      "name": "BC Timber Sales",
      "sector": "forests",
      "description": "BCTS lockups with the Forest Service tree oval and the ministry wildlife oval.",
      "match": { "family": ["^bcts-"] }
    },
    {
      "id": "bc-wildfire-service",
      "name": "BC Wildfire Service",
      "sector": "forests",
      "description": "Ovals and patches naming the Wildfire Service or Wildfire Management.",
      "match": { "family": ["wildfire"] }
    },
    {
      "id": "bc-forest-service",
      "name": "BC Forest Service",
      "sector": "forests",
      "description": "The Forest Service and the Ministry of Forests: tree ovals, shoulder patches, metal badges, fire-control and prevention marks.",
      "match": { "affiliation": ["Forestry"] }
    },
    {
      "id": "forest-practices-board",
      "name": "Forest Practices Board",
      "sector": "forests",
      "match": { "family": ["^forest-practices-board$"] }
    },
    {
      "id": "managed-forest-council",
      "name": "Managed Forest Council",
      "sector": "forests",
      "match": { "family": ["^managed-forest-council$"] }
    },
    {
      "id": "forest-enhancement-society",
      "name": "Forest Enhancement Society of BC",
      "sector": "forests",
      "match": { "family": ["^fesbc$"] }
    },
    {
      "id": "canadian-forestry-association",
      "name": "Canadian Forestry Association",
      "sector": "forests",
      "description": "Junior Forest Warden badge; an association, not a ministry patch.",
      "match": { "affiliation": ["Canadian Forestry Association"] }
    },
    {
      "id": "bc-parks",
      "name": "BC Parks",
      "sector": "environment",
      "description": "Parks Branch and the ministries that held it: arches, shields, rockers and ranger badges.",
      "match": { "affiliation": ["Parks"] }
    },
    {
      "id": "conservation-officer-service",
      "name": "Conservation Officer Service",
      "sector": "environment",
      "description": "Conservation Officer shoulder, cap and blazer emblems, rockers and the 2005 centennial tabs.",
      "match": { "family": ["^bc-co-", "^conservation-", "^bc-environment-cap-", "^bc-province-cap-"], "label": ["conservation officer"] }
    },
    {
      "id": "fish-and-wildlife-branch",
